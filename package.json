{
  "name": "tcg-react",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "generate-images-manifest": "node scripts/generate-image-manifest.mjs",
    "predev": "node scripts/generate-image-manifest.mjs",
    "prebuild": "node scripts/generate-image-manifest.mjs",
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/build-offline.mjs",
    "lint": "eslint .",
    "pretest": "node scripts/generate-image-manifest.mjs",
    "test": "node scripts/run-tests.mjs",
    "check:build": "node scripts/check-build.mjs && node scripts/check-distribution.mjs",
    "check": "npm test && npm run lint && npm run build && npm run check:build && npm run test:browser",
    "preview": "vite preview",
    "premockup": "node scripts/generate-image-manifest.mjs",
    "mockup": "vite --config vite.mockup.config.js",
    "premockup:ui": "node scripts/generate-image-manifest.mjs",
    "mockup:ui": "vite --config vite.ui-mockup.config.js --open /ui-mockup.html",
    "prebuild:mockup": "node scripts/generate-image-manifest.mjs",
    "build:mockup": "npm run build",
    "sample:build": "node scripts/build-sample.mjs",
    "harness:preflight": "node scripts/harness.mjs preflight",
    "harness:check": "node scripts/harness.mjs check",
    "test:browser": "playwright test",
    "ai:serve": "node scripts/ai-server.mjs",
    "ai:mcp": "node scripts/mcp.mjs",
    "native:dev": "tauri dev",
    "native:windows": "tauri build --bundles nsis",
    "native:android": "tauri android build --apk --target aarch64"
  },
  "dependencies": {
    "@tauri-apps/plugin-opener": "^2.7.0",
    "fflate": "0.8.3",
    "jspdf": "^4.2.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-window": "^1.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "^1.58.2",
    "@tauri-apps/api": "2.12.2",
    "@tauri-apps/cli": "2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^5.1.2",
    "ajv": "8.20.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.2.4",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.5",
    "vite": "^7.2.7"
  },
  "homepage": "."
}
